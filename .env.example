# Copy this file to `.env` (`task install` does it for you).
# These are read by Docker Compose and the Taskfile, not by the app itself.
# The app reads only PORT and HOST, which the compose file already sets.

# Published image tag used by `task install` / `task update`. `latest` follows
# the newest release, so `task update` moves you to it. To control upgrades
# yourself, pin a v-prefixed release (e.g. TAG=v1.3.0). Ignored when building
# from source (`task up`).
TAG=latest

# Host port published for the app. Behind the TLS proxy set this to
# 127.0.0.1:3000 so plain HTTP stays on loopback and only Caddy is reachable.
APP_PORT=3000

# Hostname the app is reached at, e.g. poker.example.com. Setting it makes
# `task install` / `task update` also start the Caddy HTTPS proxy
# (docker-compose.tls.yml). Leave empty to serve plain HTTP.
SITE_ADDRESS=
